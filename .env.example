# =====================================================================
# Авторизация в Max (oneme.ru)
# Значения берутся из web.max.ru (DevTools → Application → Local Storage):
# 1. MAX_TOKEN: поле "token" из JSON-объекта __oneme_auth
# 2. MAX_DEVICE_ID: значение __oneme_device_id
# ВАЖНО: После копирования токена закройте вкладку web.max.ru,
# чтобы не было конфликта двух сессий с одного токена.
# =====================================================================
MAX_TOKEN=your___oneme_auth_token_here
MAX_DEVICE_ID=your___oneme_device_id_here

# (Опционально) Фильтрация чатов Max через запятую.
# Если не указано — бот слушает все доступные чаты.
# MAX_CHAT_IDS=-123456789,987654321

# (Опционально) Список чатов Max, которые нужно исключить из пересылки.
# MAX_EXCLUDE_CHAT_IDS=-111222333

# (Опционально) Количество чатов, загружаемых при старте (по умолчанию: 100)
# MAX_CHATS_COUNT=100

# (Опционально) SOCKS5-прокси для Max (socks5://user:pass@host:port)
# Если используете прокси — в веб-версию для получения токена заходите через него же!
# MAX_PROXY=socks5://127.0.0.1:1080

# =====================================================================
# Telegram
# Токен бота получаем у @BotFather
# Chat ID узнаем через @userinfobot (для групп ID начинается с минуса)
# =====================================================================
TG_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789
TG_CHAT_ID=123456789

# (Опционально) SOCKS5-прокси для Telegram
# TG_PROXY=socks5://127.0.0.1:1080

# (Опционально) Таймауты запросов к Telegram в секундах
# TG_READ_TIMEOUT=30
# TG_WRITE_TIMEOUT=30
# TG_MEDIA_WRITE_TIMEOUT=120

# (Опционально) Собственный сервер Telegram Bot API (например, http://localhost:8081)
# TG_BASE_URL=http://localhost:8081

# =====================================================================
# Настройки работы форвардера и моста
# =====================================================================

# Разрешить отправку ответов из Telegram обратно в Max (true/false)
REPLY_ENABLED=true

# Автоматическое распределение чатов Max по темам (форумам) Telegram (true/false)
# Требуется группа Telegram с включёнными темами (Topics/Forum).
ENABLE_TOPICS=true

# Показывать inline-кнопку «Ответить» под каждым пересланным сообщением (true/false)
# Если отключено (false) — в темах можно просто писать текст или отвечать через «Reply»
SHOW_REPLY_BUTTON=false

# Эмодзи реакции-подтверждения на сообщение в TG при успешной отправке в Max
# По умолчанию: 👍 (оставьте пустым для отключения реакций)
DELIVERY_REACTION=👍

# Количество последних сообщений чатов для досылки при старте/переподключении
# Позволяет не терять сообщения, пришедшие когда бот был офлайн (0 — отключить)
SYNC_HISTORY_COUNT=20

# Подробные логи и дамп сырого JSON в папку debug/ (true/false)
DEBUG=false

# Папка для хранения логов (по умолчанию logs)
LOG_DIR=logs
